# ---- API server (server/index.ts) ----
PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# ---- Frontend (Vite, baked in at build time) ----
# Same Supabase project as above. The anon key is public by design; RLS protects data.
# Without these the app renders, but student auth flows stay disabled.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-project-anon-key
